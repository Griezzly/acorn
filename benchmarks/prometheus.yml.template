global:
  scrape_interval: 5s
  evaluation_interval: 5s
  external_labels:
    cluster: 'oakestra-benchmark'
    environment: 'hetzner-cloud'

# Alertmanager configuration (optional)
# alerting:
#   alertmanagers:
#     - static_configs:
#         - targets: []

# Load rules once and periodically evaluate them
# rule_files:
#   - "alerts.yml"

scrape_configs:
  # Prometheus self-monitoring
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Oakestra worker nodes (Node Exporter)
  # This section will be auto-generated by the setup script
  - job_name: 'oakestra-workers'
    scrape_interval: 5s
    static_configs:
      - targets:
# WORKER_TARGETS_PLACEHOLDER
        # Targets added by setup-observability.sh