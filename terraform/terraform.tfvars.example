# Copy this file to terraform.tfvars and fill in your actual values
# terraform.tfvars is automatically loaded by Terraform

# Required: Your Hetzner Cloud API Token
hcloud_token = "your-hcloud-api-token-here"

# Optional: Customize server names (defaults provided)
orchestrator_name   = "thesis-test-node-1"
worker_count        = 2  # Number of worker nodes (1-10)
worker_name_prefix  = "thesis-test-worker"  # Will create worker-1, worker-2, etc.

# Optional: Server type (default: cpx11 - 2 CPU, 2GB RAM, 40GB disk)
server_type = "cpx11"

# Optional: Location (default: nbg1 - Nuremberg)
location = "nbg1"

# IMPORTANT: SSH Keys to add to servers - REQUIRED for access
# Get your SSH key names with: hcloud ssh-key list
# Or get fingerprints with: hcloud ssh-key list --output columns=name,fingerprint
ssh_keys = [
  "your-ssh-key-name"  # UNCOMMENT and replace with your actual SSH key name
  # "another-ssh-key-name"  # Add more if needed
]